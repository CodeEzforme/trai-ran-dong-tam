# Server only. Configure the actual values in hosting environment variables.
CMS_ADMIN_USERNAME=Admin
CMS_PASSWORD_HASH=
CMS_SESSION_SECRET=
CMS_GITHUB_TOKEN=

# Optional canonical origin. Leave empty to use the deployment's own origin.
CMS_ORIGIN=

# Set only on the GitHub Pages build, so /admin/ opens the server-backed CMS.
NEXT_PUBLIC_ADMIN_URL=
